{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2024", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    // An app, not a library: nothing imports its types, and its pages' types name server internals.
    "composite": false,
    "declaration": false,
    "emitDeclarationOnly": false,
    "noEmit": true
  },
  "include": ["src", "test", "vite.config.ts"],
  "references": [{ "path": "../server" }]
}
