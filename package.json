{
  "name": "twofiat-commander",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev:server": "pnpm --filter @twofiat/server dev",
    "dev:web": "pnpm --filter @twofiat/web dev",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "capture": "node --env-file=.env packages/twofiat-client/scripts/capture.ts",
    "report": "node packages/twofiat-client/scripts/report.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "^24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
